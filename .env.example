# ============================================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================================
# Configuration for Razorpay payment processing (subscriptions, orders, payouts).
# Get credentials from: https://dashboard.razorpay.com/app/settings/api-keys
#
# RAZORPAY_KEY_ID: Public key for frontend checkout SDK (safe to expose)
# RAZORPAY_KEY_SECRET: Secret key for backend API calls (server-only, rotate on exposure)
# RAZORPAY_WEBHOOK_SECRET: Webhook signature verification (server-only)
#
# Test credentials: Use https://razorpay.com/docs/payments/payment-gateway/test-card-details/
# Production: Replace with real keys from your live Dashboard

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-secret-key-here
RAZORPAY_WEBHOOK_SECRET=webhook-secret-here

# Frontend-only Razorpay key (published in VITE_* env; safe for client)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ============================================================================
# RAZORPAY WEBHOOK TESTING (Local Development)
# ============================================================================
# ngrok tunnel for local Razorpay webhook testing
# Get your auth token at: https://dashboard.ngrok.com/authtokens
# Get a free static domain at: https://dashboard.ngrok.com/domains
#
# After setting auth token, run: `ngrok http 3000 --domain=<your-domain>`
# Two Razorpay webhooks share the same RAZORPAY_WEBHOOK_SECRET (both raw-body,
# signature-verified). Add BOTH in the Razorpay Dashboard:
#   - Subscriptions/billing: https://<your-domain>/api/subscriptions/webhook
#   - Storefront order payments: https://<your-domain>/api/payments/webhook

NGROK_AUTH_TOKEN=
NGROK_DOMAIN=postlike-overdiscriminatingly-jalisa.ngrok-free.dev
