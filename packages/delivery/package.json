{
  "name": "@restropulse/delivery",
  "version": "1.0.0",
  "private": true,
  "description": "Delivery provider layer: one interface for rider partners, plus the dispatcher (Phase 2, M4)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@restropulse/shared": "*"
  },
  "devDependencies": {
    "@restropulse/tsconfig": "*",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
