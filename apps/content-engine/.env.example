# @env tag-format: owner=<component|shared|root|unknown> <required|optional> <runtime|buildtime> <secret|public> state=<active|stale|orphan|workflow-only>

# RestroPulse Content Engine - Environment Variables
# Copy to .env and fill in real values

# @env owner=shared optional runtime public state=active
NODE_ENV=development

# MongoDB Connection
# @env owner=shared required runtime secret state=active
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# @env owner=shared optional runtime secret state=active
MONGODB_DB_NAME=restropulse

# Local Asset Server
# Run `npm run download-assets` once before starting the worker to populate assets/
# @env owner=content-engine optional runtime public state=active
ASSET_SERVER_PORT=3002
# Local: content-engine's built-in HTTP server (default)
# @env owner=shared optional runtime public state=active
ASSET_SERVER_BASE_URL=http://localhost:3002
# Staging/production: API's /content static route
# ASSET_SERVER_BASE_URL=https://restropulse-prod-api-staging.azurewebsites.net/content/mockdata
