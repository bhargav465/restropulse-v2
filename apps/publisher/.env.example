# @env tag-format: owner=<component|shared|root|unknown> <required|optional> <runtime|buildtime> <secret|public> state=<active|stale|orphan|workflow-only>

# RestroPulse Publisher - Environment Variables
# Copy to .env and fill in real values

# @env owner=shared optional runtime public state=active
NODE_ENV=development

# MongoDB Connection
# @env owner=shared required runtime secret state=active
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# @env owner=shared optional runtime secret state=active
MONGODB_DB_NAME=restropulse

# Instagram/Meta Integration
# @env owner=shared required runtime public state=active
INSTAGRAM_APP_ID=your-instagram-app-id
# @env owner=shared required runtime secret state=active
INSTAGRAM_APP_SECRET=your-instagram-app-secret
# @env owner=shared optional runtime secret state=active
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/integrations/instagram/callback

# Encryption key for token storage (64 hex characters)
# @env owner=shared required runtime secret state=active
ENCRYPTION_KEY=your-64-character-hex-encryption-key
