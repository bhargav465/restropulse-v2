# RestroPulse Publisher - Environment Variables
# Copy to .env and fill in real values

NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=restropulse

# Instagram/Meta Integration
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/integrations/instagram/callback

# Encryption key for token storage (64 hex characters)
ENCRYPTION_KEY=your-64-character-hex-encryption-key
