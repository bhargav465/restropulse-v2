# @env tag-format: owner=<component|shared|root|unknown> <required|optional> <runtime|buildtime> <secret|public> state=<active|stale|orphan|workflow-only>

# RestroPulse PWA - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL
# @env owner=web required buildtime public state=active
VITE_API_URL=http://localhost:3001/api
# Frontend public URL -- baked into Firebase email verification links as continueUrl.
# Must match the canonical URL for this environment.
# @env owner=web required buildtime public state=active
VITE_APP_URL=http://localhost:3000

# Firebase Configuration (get from Firebase Console > Project Settings > Web App)
# If not set, the app will use fallback OTP authentication (dev mode only)
# @env owner=web required buildtime secret state=active
VITE_FIREBASE_API_KEY=your-api-key
# @env owner=web required buildtime secret state=active
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# @env owner=web required buildtime secret state=active
VITE_FIREBASE_PROJECT_ID=your-project-id
# @env owner=web optional buildtime secret state=active
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# @env owner=web optional buildtime secret state=active
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# @env owner=web optional buildtime secret state=active
VITE_FIREBASE_APP_ID=1:123456789:web:abc123