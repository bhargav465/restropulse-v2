# RestroPulse PWA - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL
VITE_API_URL=http://localhost:3001/api
# Frontend public URL -- baked into Firebase email verification links as continueUrl.
# Must match the canonical URL for this environment.
VITE_APP_URL=http://localhost:3000

# Firebase Configuration (get from Firebase Console > Project Settings > Web App)
# If not set, the app will use fallback OTP authentication (dev mode only)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
# Instagram OAuth Integration
# Get INSTAGRAM_APP_ID from: https://developers.facebook.com/apps > Your App > App Settings > Basic
# This is the same as the Facebook App ID
VITE_INSTAGRAM_APP_ID=your-instagram-app-id

# Redirect URI for OAuth callback (must match Meta Developer Console configuration)
# For development: http://localhost:3000/instagram/callback
# For production: https://yourdomain.com/instagram/callback
VITE_INSTAGRAM_REDIRECT_URI=http://localhost:3000/instagram/callback

# Google Maps browser key for the "Add my restaurant" place picker (Brief 10).
# This is a PUBLIC, HTTP-REFERRER-RESTRICTED browser key with "Maps JavaScript
# API" + "Places API" enabled — NEVER the server key (GOOGLE_MAPS_API_KEY lives
# only on the API service). Lock it to your web origins in Google Cloud Console.
# Falls back to VITE_GOOGLE_MAPS_API_KEY when unset.
VITE_GOOGLE_MAPS_BROWSER_KEY=your-referrer-restricted-browser-key