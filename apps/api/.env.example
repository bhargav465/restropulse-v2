PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# MongoDB Connection
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=restropulsev1

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-change-in-production

# Instagram OAuth Integration (Meta Graph API v18.0)
# Get these from: https://developers.facebook.com/apps > Your App > App Settings > Basic
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Redirect URI must match exactly what's configured in Meta Developer Console
# For development: http://localhost:3000/instagram/callback
# For production: https://yourdomain.com/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/instagram/callback

# Encryption key for storing tokens securely (32 bytes for AES-256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# Firebase Admin SDK (for production phone authentication)
# Option 1: Service Account Key (paste the entire JSON content)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Option 2: Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Feature Flags
FEATURE_DELETE_ACCOUNT=false
# --- Online ordering (v1) ---
# The ordering platform introduces NO new required environment variables.
# It reuses the existing configuration:
#   MONGODB_URI / MONGODB_DB_NAME -- ordering collections (restaurants, menu_categories,
#                                    menu_items, orders, reservations, storefront_content,
#                                    customers, events) live in the same database
#   JWT_SECRET                    -- signs BOTH merchant JWTs and storefront customer JWTs
#                                    (customer tokens carry role: 'customer')
#   CORS_ORIGIN                   -- merchant dashboard origin; in local dev the storefront
#                                    (port 3003) reaches the API via the Vite /api proxy, so
#                                    no extra origin is needed. For a hosted storefront on its
#                                    own domain, add that origin to the CORS config in server.ts.
# Customer passwords are hashed with bcryptjs using a fixed salt-rounds
# constant (BCRYPT_SALT_ROUNDS in src/services/password.ts).
