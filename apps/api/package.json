{
    "name": "@restropulse/api",
    "version": "1.0.0",
    "description": "Backend API for RestroPulse PWA",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "dev:debug": "tsx --inspect watch src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "db:seed": "cd ../db-cli && npm run seed:clean"
    },
    "keywords": [
        "restropulse",
        "api",
        "backend"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@restropulse/shared": "*",
        "@restropulse/telemetry": "*",
        "@restropulse/db": "*",
        "@restropulse/publishing": "*",
        "@restropulse/secrets": "*",
        "axios": "^1.13.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "firebase-admin": "^13.6.0",
        "form-data": "^4.0.5",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^6.12.0",
        "node-cron": "^4.2.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.14.0",
        "@types/node-cron": "^3.0.11",
        "@types/supertest": "^6.0.2",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "mongodb-memory-server": "^11.0.1",
        "supertest": "^6.3.3",
        "tsx": "^4.7.0",
        "typescript": "~5.8.2",
        "vitest": "^4.0.18"
    }
}