# Dispatch worker (Phase 2, M4). Same database as the API.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=restropulse
# How often to drain due jobs, and how often to poll partners without webhooks (ms).
DISPATCH_INTERVAL_MS=5000
DISPATCH_POLL_MS=30000
# Test partner (never in production). Must match the API's values.
# DELIVERY_MOCK_ENABLED=true
# DELIVERY_MOCK_MINUTE_MS=60000
# MOCK_DELIVERY_WEBHOOK_SECRET=
