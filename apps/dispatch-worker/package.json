{
  "name": "@restropulse/dispatch-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Rider dispatch worker -- drains the delivery_jobs outbox and polls delivery partners (Phase 2, M4)",
  "type": "module",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/worker.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@restropulse/db": "*",
    "@restropulse/delivery": "*",
    "@restropulse/shared": "*",
    "@restropulse/telemetry": "*"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
