# Restaurant sites host (Phase 2 M3)
PORT=3004
# API the server reads restaurant data from
API_URL=http://localhost:3001
# API the browser calls for cart and checkout (defaults to API_URL)
PUBLIC_API_URL=http://localhost:3001
# This host's own origin; /r/<slug> previews are served only here
SITES_BASE_URL=http://localhost:3004
# Wildcard root for <slug>.<root> sites, once *.<root> DNS exists
# SITES_ROOT_DOMAIN=restropulse.in
# Shared secret the edge (Cloudflare) adds as X-RestroPulse-Edge for owners' own domains
# SITES_EDGE_SECRET=
# SITES_CACHE_TTL_MS=60000
