# RestroPulse Storefront - Environment Variables
# Copy this file to .env and fill in your values.

# Backend API base URL (must include the /api suffix).
# Leave unset in local dev: the Vite dev server proxies /api -> http://localhost:3001
# using ports from config/ports.json, so the default fallback of "/api" just works.
# Set explicitly for hosted deployments, e.g. https://api.yourdomain.com/api
VITE_API_URL=http://localhost:3001/api
