{
  "mcpServers": {
    "semantic-search": {
      "command": "${USERPROFILE}/.bun/bin/bun",
      "args": [
        "run",
        "${USERPROFILE}/.mcp-servers/codebase-rag/src/server.ts"
      ],
      "env": {
        "CODEBASE_RAG_EXCLUDE": "node_modules,dist,.turbo,coverage,html,public/mockdata,assets/videos,assets/images,*.lock,package-lock.json"
      }
    },
    "lsp-web": {
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "./apps/web",
        "--lsp",
        "typescript-language-server",
        "--",
        "--stdio"
      ]
    },
    "lsp-api": {
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "./apps/api",
        "--lsp",
        "typescript-language-server",
        "--",
        "--stdio"
      ]
    },
    "lsp-publisher": {
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "./apps/publisher",
        "--lsp",
        "typescript-language-server",
        "--",
        "--stdio"
      ]
    },
    "lsp-content-engine": {
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "./apps/content-engine",
        "--lsp",
        "typescript-language-server",
        "--",
        "--stdio"
      ]
    },
    "lsp-shared": {
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "./packages/shared",
        "--lsp",
        "typescript-language-server",
        "--",
        "--stdio"
      ]
    },
    "lsp-db": {
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "./packages/db",
        "--lsp",
        "typescript-language-server",
        "--",
        "--stdio"
      ]
    },
    "project-memory": {
      "command": "mcp-server-memory"
    },
    "azure": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "lighthouse": {
      "command": "npx",
      "args": [
        "-y",
        "lighthouse-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}