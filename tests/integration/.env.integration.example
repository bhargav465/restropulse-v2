# @env tag-format: owner=<component|shared|root|unknown> <required|optional> <runtime|buildtime> <secret|public> state=<active|stale|orphan|workflow-only>

# Integration test secrets -- copy to .env.integration and fill in real values.
# ALL secrets must be present when running integration tests (no skip mechanism).
# NEVER commit .env.integration -- it is gitignored.

# Database
# @env owner=shared required runtime secret state=active
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# @env owner=shared optional runtime secret state=active
MONGODB_DB_NAME=restropulse-dev

# Auth
# @env owner=shared required runtime secret state=active
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# @env owner=api required runtime secret state=active
JWT_SECRET=change-me-in-production

# Meta / Instagram
# @env owner=shared required runtime public state=active
INSTAGRAM_APP_ID=
# @env owner=shared required runtime secret state=active
INSTAGRAM_APP_SECRET=
# @env owner=tests optional runtime secret state=active
INSTAGRAM_TEST_ACCESS_TOKEN=

# AI backends
# @env owner=shared optional runtime secret state=active
ANTHROPIC_API_KEY=sk-ant-api03-...
# @env owner=content-engine optional runtime secret state=active
REPLICATE_API_TOKEN=r8_...
# @env owner=content-engine optional runtime secret state=active
GOOGLE_CALENDAR_API_KEY=AIzaSy...
# @env owner=content-engine optional runtime secret state=active
PERPLEXITY_API_KEY=pplx-...

# Payments
# @env owner=shared optional runtime secret state=active
RAZORPAY_KEY_ID=rzp_test_...
# @env owner=shared optional runtime secret state=active
RAZORPAY_KEY_SECRET=
