# Integration test secrets -- copy to .env.integration and fill in real values.
# ALL secrets must be present when running integration tests (no skip mechanism).
# NEVER commit .env.integration -- it is gitignored.

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=restropulse-dev

# Auth
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=change-me-in-production

# Meta / Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_TEST_ACCESS_TOKEN=

# AI backends
ANTHROPIC_API_KEY=sk-ant-api03-...
REPLICATE_API_TOKEN=r8_...
GOOGLE_CALENDAR_API_KEY=AIzaSy...
PERPLEXITY_API_KEY=pplx-...

# Payments
